# Copy this file to a local untracked file, for example:
#   cp .env.preview.example .env.preview
# Then edit the values and source it before building/deploying:
#   set -a; source ./.env.preview; set +a

# Local build/deploy settings
PREVIEW_HOST=your-vps.example.com
PREVIEW_USER=deploy
PREVIEW_PATH=/var/www/fantasy-dashboard-preview
BUILD_DIR=dist/apps/fantasy-angular/browser
RSYNC_RSH='ssh'

# VPS nginx/basic-auth setup settings
PREVIEW_DOMAIN=your-vps.example.com
BASIC_AUTH_USER=preview-admin
NGINX_SITE_NAME=fantasy-dashboard-preview
BASIC_AUTH_FILE=/etc/nginx/.htpasswd-fantasy-preview
ENABLE_UFW=false
